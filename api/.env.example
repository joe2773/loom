# Copy to .env for local dev. Loaded automatically by dotenv when NODE_ENV !== 'production'.
# In Cloud Run these are injected by the platform; do not deploy .env.

# GCS bucket holding uploaded videos
BUCKET_NAME=loom-videos-local

# CORS origin for the SPA (or '*' for local dev)
ALLOWED_ORIGIN=http://localhost:5173

# Postgres connection. Matches docker-compose.yml in this directory.
DATABASE_URL=postgres://loom:loom@localhost:5432/loom

# 32+ byte random secret for signing app JWTs (HS256).
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-secret

# OAuth 2.0 Web client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

NODE_ENV=development
